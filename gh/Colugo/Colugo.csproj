<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 的插件运行时是 .NET 7。
         注意：NuGet 上的 RhinoCommon 8.15 包只有 net48 资产（会触发 NU1701 并拉到错误的运行时变体），
         所以这里直接引用本机安装的 .NET 7 程序集。换机器时改 RhinoDir 即可。 -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 预览窗口是 WPF + WebView2：Rhino 8 自带 Microsoft.Web.WebView2.Wpf.dll -->
    <UseWPF>true</UseWPF>
    <AssemblyName>Colugo</AssemblyName>
    <RootNamespace>Colugo</RootNamespace>
    <Version>0.36.0</Version>
    <Title>Colugo · Grasshopper Creative Engine</Title>
    <Description>把 Grasshopper 定义为创意编程前端，浏览器为执行环境。</Description>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 自动探测 Rhino 8 安装位置，换机器不用改文件。
         要强制指定：dotnet build -c Release -p:RhinoDir="C:\Program Files\Rhino 8" -->
    <_RhinoC1 Condition="'$(RhinoDir)' == '' AND Exists('C:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll')">C:\Program Files\Rhino 8</_RhinoC1>
    <_RhinoC2 Condition="'$(RhinoDir)' == '' AND Exists('D:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll')">D:\Program Files\Rhino 8</_RhinoC2>
    <_RhinoC3 Condition="'$(RhinoDir)' == '' AND Exists('E:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll')">E:\Program Files\Rhino 8</_RhinoC3>
    <_RhinoC4 Condition="'$(RhinoDir)' == '' AND Exists('$(ProgramW6432)\Rhino 8\System\netcore\RhinoCommon.dll')">$(ProgramW6432)\Rhino 8</_RhinoC4>
    <_RhinoC5 Condition="'$(RhinoDir)' == '' AND Exists('$(ProgramFiles)\Rhino 8\System\netcore\RhinoCommon.dll')">$(ProgramFiles)\Rhino 8</_RhinoC5>
    <RhinoDir Condition="'$(RhinoDir)' == ''">$(_RhinoC1)$(_RhinoC2)$(_RhinoC3)$(_RhinoC4)$(_RhinoC5)</RhinoDir>

    <RuntimeDir Condition="'$(RuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\runtime</RuntimeDir>
  </PropertyGroup>

  <Target Name="CheckRhinoDir" BeforeTargets="PrepareForBuild" Condition="'$(RhinoDir)' == ''">
    <Error Text="找不到 Rhino 8 的 .NET 7 程序集（System\netcore\RhinoCommon.dll）。请指定安装目录：dotnet build -c Release -p:RhinoDir=&quot;C:\Program Files\Rhino 8&quot;" />
  </Target>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoDir)\System\netcore\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>$(RhinoDir)\Plug-ins\Grasshopper\Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(RhinoDir)\Plug-ins\Grasshopper\GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(RhinoDir)\System\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(RhinoDir)\System\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 运行时页面内嵌进 .gha：装完就能用，不需要 node、不需要额外文件夹。
       LogicalName 决定资源名，BridgeServer 按 "rt/..." 前缀取。 -->
  <ItemGroup>
    <EmbeddedResource Include="$(RuntimeDir)\index.html">
      <LogicalName>rt/index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(RuntimeDir)\src\*.js">
      <LogicalName>rt/src/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Three.js r186：WebGPU 渲染器 + TSL。三个文件互为相对依赖，必须同目录 -->
    <EmbeddedResource Include="$(RuntimeDir)\vendor\*.js">
      <LogicalName>rt/vendor/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Grasshopper 认的是 .gha 扩展名，内容就是普通托管 DLL，所以编译后顺手复制一份 -->
  <Target Name="MakeGha" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).gha" />
  </Target>

</Project>
